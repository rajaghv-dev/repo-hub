# Required — GitHub API (5000 req/hr with token vs 60 without)
GITHUB_TOKEN=ghp_...

# Required — HuggingFace Hub API
HF_TOKEN=hf_...

# Required — PostgreSQL connection string (Neon recommended: neon.tech)
# Supabase: Project Settings → Database → URI
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Required — Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
REPO_HUB_GCS_BUCKET=your-bucket-name
REPO_HUB_GCS_PREFIX=repo-hub/

# Optional — override defaults
REPO_HUB_DATA_DIR=./data
REPO_HUB_CONFIG_DIR=./config
ANTHROPIC_API_KEY=sk-ant-...       # Phase 2: LLM classification
